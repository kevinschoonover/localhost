############################################
# Table of Contents:
#   -> Alias
#   -> Color
#   -> Core
#   -> URL
############################################

#######
# Alias
#######
[alias]
    g = !git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative

#######
# Color 
#######
[color]
    ui = true

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = yellow
    changed = green
    untracked = red

#####
# URL 
#####
[url "https://github.com/"]
    insteadOf = gh:

[url "https://gist.github.com/"]
    insteadOf = gist:

[url "https://bitbucket.org/"]
    insteadOf = bb:
[user]
	email = github@kschoon.me
	name = Kevin Schoonover
[pull]
	rebase = true

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true    # use n and N to move between diff sections
	light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)

[delta]
    line-numbers = true


[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default
[commit]
	gpgsign = true
[credential "https://github.com"]
	helper = 
	helper = !/nix/store/fz2h6h3cgw645ighi31zdjwbkdzmaav7-gh-2.96.0/bin/.gh-wrapped auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/nix/store/fz2h6h3cgw645ighi31zdjwbkdzmaav7-gh-2.96.0/bin/.gh-wrapped auth git-credential
[init]
	templateDir = /home/kschoon/.git-templates
